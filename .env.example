# ============================================================
# MSME Delivery & Acceptance Ledger — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# ----------------------------------------------------------
# Supabase (Backend)
# ----------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ----------------------------------------------------------
# FastAPI Backend
# ----------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development

# ----------------------------------------------------------
# Ethereum / Blockchain
# ----------------------------------------------------------
# Testnet RPC URL (e.g., Alchemy / Infura Sepolia endpoint)
ETHEREUM_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your-api-key
# Private key used only for Hardhat deployments (testnet only — never use mainnet keys here)
DEPLOYER_PRIVATE_KEY=your-testnet-private-key

# ----------------------------------------------------------
# Frontend (Vite — prefix VITE_ for browser-exposed vars)
# ----------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
